root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yml,yaml,json,toml}]
indent_style = space
indent_size = 2

[*.{sh,bash}]
indent_style = space
indent_size = 2

# C sources and the shield's devicetree files.
[*.{c,h,overlay,keymap,dtsi}]
indent_style = space
indent_size = 4

# Markdown: two trailing spaces are a line break.
[*.md]
trim_trailing_whitespace = false
