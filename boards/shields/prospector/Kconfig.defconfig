#
# Display defaults for the Prospector hardware (Waveshare 1.69" 240x280 ST7789V
# over SPI3, RGB565, landscape). Values follow prospector-zmk-module v2.2.3
# boards/shields/prospector_scanner/Kconfig.defconfig, which the same panel
# runs on. ZMK_DISPLAY_STATUS_SCREEN_CUSTOM points ZMK at
# src/prospector_screen.c.

if SHIELD_PROSPECTOR

config ZMK_KEYBOARD_NAME
    default "Prospector"

config ZMK_DISPLAY
    default y

config MIPI_DBI
    bool
    default y

config SPI
    default y

choice ST7789V_PIXEL_FORMAT
    default ST7789V_RGB565
endchoice

config LV_Z_VDB_SIZE
    default 100

config LV_DPI_DEF
    default 261

config LV_Z_BITS_PER_PIXEL
    default 16

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_16
endchoice

config LV_COLOR_16_SWAP
    default y

# The LVGL pool (sys_heap). A sprite's decoder keeps one allocation in it for
# the whole run (gd_GIF header + 5 B per pixel + a 16 KiB LZW cache, about
# 60 KB for a 90x90 px GIF); the rest serves the widgets and the draw tasks,
# under 5 KB on hardware (2026-09-27). CMakeLists.txt checks a GIF against
# this value at build time. 88 KiB keeps RAM under 90% in a logging build and
# leaves room for a GIF of about 110x110 px.
config LV_Z_MEM_POOL_SIZE
    default 90112 if BEACON_SPRITE
    default 49152

choice ZMK_DISPLAY_STATUS_SCREEN
    default ZMK_DISPLAY_STATUS_SCREEN_CUSTOM
endchoice

config BEACON_BOOTLOADER_ON_1200_BAUD
    default y

endif
