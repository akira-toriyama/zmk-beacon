# Module-wide options. Every symbol carries the BEACON_ prefix so the module
# can share a manifest with prospector-zmk-module (PROSPECTOR_*, ZMK_STATUS_ADV_*)
# while canon migrates from it.

menu "Beacon"

config BEACON_BACKLIGHT_BRIGHTNESS
    int "Backlight brightness at boot (percent)"
    range 0 100
    default 80
    depends on LED_PWM
    help
      Duty cycle written to the pwm-leds backlight before the display driver
      starts. The unit has no ambient light sensor, so this value is fixed for
      the whole runtime.

config BEACON_BOOTLOADER_ON_1200_BAUD
    bool "Enter the UF2 bootloader on a 1200 baud touch"
    depends on USB_CDC_ACM && RETENTION_BOOT_MODE
    select CDC_ACM_DTE_RATE_CALLBACK_SUPPORT
    help
      When the host sets any CDC ACM port of the device to 1200 baud (for
      example "stty -f /dev/cu.usbmodemXXXX 1200" on macOS), set the retained
      boot mode to bootloader and warm-reboot 250 ms later, so the UF2
      bootloader mounts its drive without a reset double-tap. The delay lets
      the host's control transfer complete before the device resets.

      Any program that sets the port to 1200 baud, a serial monitor included,
      reboots the device. The prospector shield turns this on by default
      because the unit has no key for &bootloader and no touch input.

config BEACON_SPRITE_GIF
    string "GIF sprite embedded in the image (absolute path, empty = none)"
    default ""
    depends on SHIELD_PROSPECTOR && ZMK_DISPLAY_STATUS_SCREEN_CUSTOM
    help
      Absolute path of a GIF89a file with a global colour table (the only
      kind LVGL's gifdec opens). The build embeds its bytes in the image and
      the status screen plays it above the battery readings, scaled by the
      largest integer factor that fits: always at the GIF's own tempo, faster
      while the keyboard is typed on (WPM from the status advertisement).
      Empty: no sprite, which is what CI and the release build.

      The decoder keeps 5 bytes per pixel plus 16 KiB in the LVGL pool for
      the whole run; the build fails when that does not fit
      CONFIG_LV_Z_MEM_POOL_SIZE (the prospector shield's default grows with a
      sprite, boards/shields/prospector/Kconfig.defconfig). Local builds:
      scripts/build.sh --sprite <gif>.

config BEACON_SPRITE
    bool
    default y if BEACON_SPRITE_GIF != ""
    select LV_USE_IMAGE
    select LV_USE_GIF
    select LV_GIF_CACHE_DECODE_DATA
    imply SYS_HEAP_RUNTIME_STATS if LOG
    help
      Set when BEACON_SPRITE_GIF names a file. LV_GIF_CACHE_DECODE_DATA is a
      correctness requirement here, not a speed option (src/sprite.c). With
      logging on, the sprite's minute line reports the LVGL pool's allocated
      and peak bytes, the numbers the pool size is chosen from.

config BEACON_STATUS_BROADCAST
    bool "Broadcast the keyboard's status on a second advertising set"
    depends on ZMK_SPLIT_ROLE_CENTRAL && BT && SETTINGS
    select BT_EXT_ADV
    select ZMK_WPM
    help
      On the keyboard's split central, advertise the status payload (each
      half's battery, the highest active layer and its name, the typing
      speed in words per minute; src/status_payload.h) as manufacturer data
      in a legacy, non-connectable, non-scannable advertising set next to
      ZMK's own connectable one. The Prospector Dongle's observer (the
      prospector shield) reads it.

      The consumer's config must also set CONFIG_BT_EXT_ADV_MAX_ADV_SET=2:
      with BT_EXT_ADV the host takes ZMK's legacy advertising from the same
      pool of sets, and the build fails on a pool of 1. BT_EXT_ADV costs
      about 34 KB of flash and 11 KB of RAM on nRF52840 and switches the host
      to the extended HCI commands (canon imprint_dongle, 2026-09-26).

config BEACON_STATUS_BROADCAST_INTERVAL_MS
    int "Advertising interval of the status set (ms)"
    depends on BEACON_STATUS_BROADCAST
    range 20 10240
    default 200
    help
      The payload is refreshed once per interval, so a scanner sees a new
      battery or layer value after at most one interval.

endmenu
