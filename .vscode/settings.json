{
  "editor.formatOnSave": true,
  "files.associations": {
    "**/*.keymap": "devicetree",
    "**/*.dtsi": "devicetree",
    "**/*.overlay": "devicetree",
    "**/*.conf": "properties"
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  }
}
